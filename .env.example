# SQLite database location. Relative paths are resolved from the project root.
DATABASE_URL=sqlite:///./food_trucks.db

# Application logging level.
LOG_LEVEL=INFO

# Default search radius used when an API request omits radius_km.
DEFAULT_RADIUS_KM=5.0

# DataSF Mobile Food Facility Permit (Socrata SODA JSON API).
FOOD_TRUCK_DATA_URL=https://data.sfgov.org/resource/rqzj-sfat.json?$limit=50000
